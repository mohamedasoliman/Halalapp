APP_NAME=Laravel
APP_ENV=local
APP_KEY=
API_KEY=
MOBILE_API_REQUIRE_VERSION=false
MOBILE_API_MIN_VERSION=
MOBILE_API_LEGACY_CATALOGUE_ENABLED=true
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_CONNECT_TIMEOUT=5
GEMINI_TIMEOUT=12

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=halalapp_11
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Manufacturer outreach remains disabled until SMTP, SPF, DKIM and DMARC are verified.
OUTREACH_ENABLED=false
OUTREACH_MAILER=outreach
OUTREACH_MAIL_HOST=mail.halalkiwi.com
OUTREACH_MAIL_PORT=587
OUTREACH_MAIL_ENCRYPTION=tls
OUTREACH_MAIL_USERNAME=products@halalkiwi.com
OUTREACH_MAIL_PASSWORD=
OUTREACH_QUEUE_CONNECTION=database
OUTREACH_QUEUE=outreach
OUTREACH_DAILY_LIMIT=20
OUTREACH_SPACING_MINUTES=3
OUTREACH_PRODUCTS_PER_EMAIL=10
OUTREACH_TIMEZONE=Pacific/Auckland
OUTREACH_FROM_ADDRESS=products@halalkiwi.com
OUTREACH_FROM_NAME="Halal Kiwi Products"
OUTREACH_REPLY_TO=products@halalkiwi.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
